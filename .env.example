# Sunday HQ — names only. Never commit real values.
# Copy to .env.local for `next dev`.

# The Odds API (https://the-odds-api.com) — DraftKings-primary NFL game lines + player props
ODDS_API_KEY=

# Shared secret for POST /api/ingest/odds, POST /api/settle/week, /api/cron/sunday-refresh
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
CRON_SECRET=
INGEST_SECRET=

# Optional. When set, snapshots persist on Vercel Blob. Without it: memory overlay + local data/snapshots.
BLOB_READ_WRITE_TOKEN=

# Optional. NWS requires a User-Agent. Without it, weather stage stays DATA UNAVAILABLE.
NWS_USER_AGENT=
